{
  "description": "Every visitor passes three checkpoints (ad reviewers 404, bots 404, datacenter/VPN click challenge), then a \"Who is the visitor?\" route sends US phone visitors to an A/B split between two quiz pages and the main offer, European visitors to the advertorial and EU offer, and everyone else to the review page and backup offer. Route rows are checked in priority order, with the last row as the fallback.",
  "graph": {
    "entry": "entry",
    "nodes": {
      "entry": {
        "id": "entry",
        "kind": "entry",
        "x": 40,
        "y": 40
      },
      "stop_reviewers": {
        "id": "stop_reviewers",
        "kind": "filter",
        "when": {
          "rule": "rl_reviewer"
        },
        "note": "Block Reviewers",
        "action": "404",
        "x": 340,
        "y": 180
      },
      "stop_bots": {
        "id": "stop_bots",
        "kind": "filter",
        "when": {
          "conds": [
            {
              "type": "bot_ua"
            }
          ]
        },
        "note": "Block Bots",
        "action": "404",
        "x": 640,
        "y": 180
      },
      "check_datacenter": {
        "id": "check_datacenter",
        "kind": "filter",
        "when": {
          "conds": [
            {
              "type": "datacenter"
            }
          ]
        },
        "note": "Check VPN",
